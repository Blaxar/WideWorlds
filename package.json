{
  "name": "wideworlds",
  "type": "module",
  "version": "0.1.0",
  "description": "3D online universe client/server solution, walking in the steps of Active Worlds",
  "main": "index.js",
  "scripts": {
    "test": "LOG_LEVEL=silent mocha -R spec \"tests/mocha/*.js\"",
    "lint-client-vue": "eslint 'client/src/**/*.vue'",
    "lint-client-js": "eslint 'client/src/**/*.js'",
    "lint-client": "npm run lint-client-vue && npm run lint-client-js",
    "lint-server": "eslint 'server/**/*.js'",
    "lint-tools": "eslint 'tools/**/*.js'",
    "lint-common": "eslint 'common/**/*.js'",
    "lint-style": "npx stylelint 'client/src/assets/*.css'",
    "lint": "npm run lint-client && npm run lint-server && npm run lint-tools && npm run lint-common && npm run lint-style",
    "server": "node server/app.js",
    "client-dev": "vite client",
    "client-build": "vite build client",
    "client-preview": "vite preview --port 4173 client",
    "doc": "node tools/doc.js > ./doc/api/v1.yaml && npx @redocly/cli build-docs ./doc/api/v1.yaml -o ./doc/api/v1.html"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Blaxar/WideWorlds.git"
  },
  "keywords": [
    "3D",
    "universe",
    "Active",
    "Worlds",
    "AW",
    "RenderWare",
    "RWX"
  ],
  "author": "Julien 'Blaxar' Bardagi",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Blaxar/WideWorlds/issues"
  },
  "homepage": "https://github.com/Blaxar/WideWorlds#readme",
  "dependencies": {
    "aw-action-parser": "npm:@blaxar/aw-action-parser@^1.1.14",
    "aw-sequence-parser": "^0.4.2",
    "awcoordinates": "^0.5.5",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-validator": "^7.2.1",
    "fflate": "^0.8.2",
    "iconv-lite": "^0.6.3",
    "image-js": "^0.36.0",
    "isomorphic-ws": "^5.0.0",
    "jsonwebtoken": "^9.0.2",
    "ml-regression-exponential": "^3.0.2",
    "pino": "^9.6.0",
    "rasterizehtml": "^1.3.1",
    "sqlite3": "^5.1.7",
    "three": ">=0.172.0",
    "three-mesh-bvh": "^0.9.0",
    "three-rwx-loader": "^0.13.2",
    "typeorm": "^0.3.20",
    "vue": "^3.5.13",
    "ws": "^8.18.0",
    "xp.css": "^0.2.6",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@redocly/cli": "^1.27.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "eslint": "^9.19.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-jsdoc": "^54.1.1",
    "eslint-plugin-vue": "^9.32.0",
    "fake-indexeddb": "^6.0.0",
    "mocha": "^11.1.0",
    "node-localstorage": "^3.0.5",
    "pino-pretty": "^13.0.0",
    "stylelint": "^16.13.2",
    "stylelint-config-standard": "^37.0.0",
    "supertest": "^7.0.0",
    "superwstest": "^2.0.4",
    "swagger-jsdoc": "^6.2.8",
    "vite": "^6.0.11",
    "yaml": "^2.7.0"
  }
}
